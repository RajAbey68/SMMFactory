#!/bin/bash
set -e
cd "$(git rev-parse --show-toplevel)"

echo ""
echo "🔒 Pre-commit: config validation + structure check"
echo ""

echo "📋 Checking JSON configs..."
for f in package.json storage.config.json; do
  if ! python3 -m json.tool "$f" > /dev/null 2>&1; then
    echo "❌ $f is invalid JSON — commit blocked"
    exit 1
  fi
done
echo "   ✅ Configs OK"

echo "📂 Checking directory structure..."
for dir in research creative landing-page campaigns; do
  if [ ! -d "$dir" ]; then
    echo "❌ Required directory '$dir' missing — commit blocked"
    exit 1
  fi
done
echo "   ✅ Structure OK"

echo "🛡️ Scanning staged files for high-entropy secrets and API tokens..."
if git diff --cached --name-only | xargs grep -E "(sk-[a-zA-Z0-9]{20,}|EAAB[a-zA-Z0-9]{20,}|98de1ee25d627e8dfe40a1f26384009f40a5)" > /dev/null 2>&1; then
  echo "❌ High-entropy secret or committed token detected in staged files — commit blocked"
  exit 1
fi
echo "   ✅ Secret scan passed"

echo ""
echo "✅ Pre-commit passed"
